# ===================================
# GAS AUTOMATION - Configuração Servidor
# Servidor: 192.168.10.156
# ===================================

# Ambiente
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# Base URL (Servidor)
API_BASE_URL=http://192.168.10.156:8000
FRONTEND_URL=http://192.168.10.156:3000

# Banco de Dados - PostgreSQL
DATABASE_URL=postgresql://gas_user:your_secure_password@postgres:5432/gas_automation
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gas_automation
DB_USER=gas_user
DB_PASSWORD=your_secure_password

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# JWT & Autenticação
JWT_SECRET=your-very-secure-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Email (para notificações)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app
SENDER_EMAIL=noreply@gasautomation.com.br

# Twilio (para WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+551122334455

# S3 / MinIO (Storage)
STORAGE_TYPE=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=gas-automation
MINIO_USE_SSL=false

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# API Keys
API_KEY_SECRET=your-secure-api-key

# Timeouts
REQUEST_TIMEOUT=30
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# CORS
CORS_ORIGINS=["http://192.168.10.156", "http://192.168.10.156:3000", "http://192.168.10.156:8000"]

# Sentry (opcional - para erro tracking)
SENTRY_DSN=

# Observações:
# 1. Substitua "your_secure_password" por uma senha real
# 2. Substitua JWT_SECRET por uma string aleatória de pelo menos 32 caracteres
# 3. Configure credenciais reais do Twilio se usar WhatsApp
# 4. Configure SMTP se usar email
# 5. Em produção, nunca commite este arquivo (use .env.local)
