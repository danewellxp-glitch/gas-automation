# ==================================================
# Configurações do Sistema de Automação de Gás
# Copie este arquivo para .env e preencha os valores
# ==================================================

# Ambiente
ENVIRONMENT=development
DEBUG=true

# SEGURANÇA - OBRIGATÓRIO: Gere chaves fortes com: openssl rand -hex 32
# NUNCA use as chaves de exemplo em produção!
SECRET_KEY=c53e3c95abef0f54392a788d50c24d0becde5b04bc47416427f76117ed0f4a0e
JWT_SECRET_KEY=36275f6a9ff91d1d60572f7acf0fccb6b63e6f11f77869614ff9dc982d90734b

# PostgreSQL
POSTGRES_USER=gasadmin
POSTGRES_PASSWORD=gasadmin123
POSTGRES_DB=gas_automation
DATABASE_URL=postgresql+asyncpg://gasadmin:gasadmin123@postgres:5432/gas_automation

# Redis
REDIS_URL=redis://redis:6379/0

# WAHA (WhatsApp HTTP API)
WAHA_URL=http://waha:3000
WAHA_SESSION_NAME=default

# Asaas (Gateway de Pagamento)
# Obtenha suas credenciais em: https://www.asaas.com/
ASAAS_API_KEY=sua_chave_api_asaas
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=token_opcional_para_validar_webhooks

# Ollama (IA Local)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# Firebird (Sistema Legado) - Opcional
# Deixe vazio se não usar integração com sistema legado
FIREBIRD_HOST=
FIREBIRD_DATABASE=
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=

# pgAdmin (Opcional - apenas desenvolvimento)
PGADMIN_EMAIL=admin@gas.local
PGADMIN_PASSWORD=admin123

# Configurações de negócio
DEFAULT_DELIVERY_TIME_MINUTES=40

# Métricas Prometheus - Token para acesso ao endpoint /metrics
METRICS_TOKEN=b8f3e9a2c4d1f6e7a3b5c8d2e9f1a4b7
