# ============================================
# Gas Automation - Configuração Frontend
# ============================================

# API Backend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Aplicação
VITE_APP_NAME=Gas Automation
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Sistema de automação de pedidos de gás via WhatsApp

# Modo Debug
VITE_DEBUG=false

# Timeouts (em milissegundos)
VITE_API_TIMEOUT=30000
VITE_WS_RECONNECT_DELAY=3000
VITE_WS_MAX_RECONNECT_ATTEMPTS=5

# Configurações de Mapa
VITE_MAP_DEFAULT_ZOOM=13
VITE_MAP_DEFAULT_LAT=-23.5505
VITE_MAP_DEFAULT_LNG=-46.6333

# Google Maps (opcional)
VITE_GOOGLE_MAPS_API_KEY=

# Sentry (opcional, para error tracking)
VITE_SENTRY_DSN=

# Analytics (opcional)
VITE_GOOGLE_ANALYTICS_ID=
